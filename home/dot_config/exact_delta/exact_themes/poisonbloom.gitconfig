[delta "poisonbloom-light"]
	light = true
	syntax-theme = Poisonbloom Light

	file-style = "#31363f"
	file-decoration-style = "#848d9f"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#848d9f" box ul
	hunk-header-line-number-style = "#484e5b"
	commit-decoration-style = "#848d9f" box ul
	blame-palette = "#f5f5f5 #ebedef #e3e5e8 #dddfe3 #cacdd3"

	minus-style = syntax "#e0d3d5"
	minus-emph-style = syntax "#d0babd"
	plus-style = syntax "#cfd9d5"
	plus-emph-style = syntax "#b3c4bd"

	line-numbers-left-style = "#848d9f"
	line-numbers-right-style = "#848d9f"
	line-numbers-zero-style = "#848d9f"
	line-numbers-minus-style = "#8d4c57"
	line-numbers-plus-style = "#386955"

	map-styles = \
		bold purple => syntax "#c9bad2", \
		bold blue => syntax "#b8c1ce", \
		bold cyan => syntax "#b4c3c5", \
		bold yellow => syntax "#c4c0b3"

[delta "poisonbloom-dark"]
	dark = true
	syntax-theme = Poisonbloom Dark

	file-style = "#c9cdd4"
	file-decoration-style = "#606876"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#606876" box ul
	hunk-header-line-number-style = "#9ca3b0"
	commit-decoration-style = "#606876" box ul
	blame-palette = "#080808 #0e0f12 #050505 #14161b #22262e"

	minus-style = syntax "#2e2325"
	minus-emph-style = syntax "#4b383b"
	plus-style = syntax "#232d28"
	plus-emph-style = syntax "#374841"

	line-numbers-left-style = "#606876"
	line-numbers-right-style = "#606876"
	line-numbers-zero-style = "#606876"
	line-numbers-minus-style = "#c8939c"
	line-numbers-plus-style = "#90c1ac"

	map-styles = \
		bold purple => syntax "#453c4b", \
		bold blue => syntax "#383f4b", \
		bold cyan => syntax "#39474a", \
		bold yellow => syntax "#4a483c"
