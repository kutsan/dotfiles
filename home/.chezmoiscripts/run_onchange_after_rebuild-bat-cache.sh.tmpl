#!/usr/bin/env bash

# Poisonbloom Dark.tmTheme hash: {{ include "dot_config/exact_bat/exact_themes/Poisonbloom Dark.tmTheme" | sha256sum }}
# Poisonbloom Light.tmTheme hash: {{ include "dot_config/exact_bat/exact_themes/Poisonbloom Light.tmTheme" | sha256sum }}

set -o errexit -o nounset -o pipefail
IFS=$'\n\t'

{{ template "logger.sh" . }}

main() {
	if ! command -v bat >/dev/null 2>&1; then
		log.warn "bat is not installed. Skipping rebuilding the bat cache."
		return 0
	fi

	log.info "Rebuilding bat cache..."

	bat cache --build

	log.success "bat cache rebuilt."
}

main "$@"
