{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

{{ $fileHashes := "" -}}
{{- range (glob (joinPath .chezmoi.sourceDir "dot_config" "exact_sketchybar" "**")) -}}
{{-   if not (stat .).isDir -}}
{{-     $fileHashes = printf "%s\n%s:%s" $fileHashes . (include . | sha256sum) -}}
{{-   end -}}
{{- end -}}
# sketchybar config hash: {{ $fileHashes | sha256sum }}

set -o errexit -o nounset -o pipefail
IFS=$'\n\t'

{{ template "logger.sh" . }}

main() {
	if ! command -v sketchybar >/dev/null 2>&1; then
		log.warn "sketchybar not installed; skipping reload."
		return 0
	fi

	if ! pgrep -qx sketchybar; then
		log.info "sketchybar not running; skipping reload."
		return 0
	fi

	log.info "Reloading sketchybar config..."

	sketchybar --reload

	log.success "sketchybar reloaded."
}

main "$@"
{{- end -}}
