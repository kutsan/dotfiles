#!/usr/bin/env bash

# plugins-lock.csv hash: {{ include "dot_config/exact_zsh/plugins-lock.csv" | sha256sum }}

set -o errexit -o nounset -o pipefail
IFS=$'\n\t'

{{ template "logger.sh" . }}
{{ template "script-environment.sh" . }}

main() {
	if ! command -v zsh >/dev/null 2>&1; then
		log.warn "Zsh is not installed. Skipping updating Zsh plugins."
		return 0
	fi

	log.info "Updating Zsh plugins..."

	# Run interactive zsh to load zinit.
	zsh -ic 'zinit update --all --no-pager'

	log.success "Zsh plugins updated."
}

main "$@"
